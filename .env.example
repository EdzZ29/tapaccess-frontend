# ─── Server-only (never exposed to the browser) ─────────────────────────────
# Where the Next.js server reaches the NestJS API. Also the target of the
# /api and /uploads rewrites in next.config.ts.
API_URL=http://localhost:4000
# Shared secret; must equal INTERNAL_API_KEY on the API. REQUIRED in
# production: it lets the API trust the visitor IP this server forwards, so
# rate limits and visit counting work per visitor rather than treating every
# visitor as this server. Production builds on Vercel fail without it.
# INTERNAL_API_KEY=
# Name of the admin session cookie (must match COOKIE_NAME on the API).
SESSION_COOKIE_NAME=tapaccess_session
# Origin of the image bucket in production, e.g. https://<project>.supabase.co
# The Content-Security-Policy only allows images from this site and this origin.
# STORAGE_ORIGIN=

# Contact buttons on the landing page (each one is optional; unset = hidden).
# CONTACT_EMAIL=hello@yourdomain.com
# CONTACT_PHONE=+63 917 123 4567
# CONTACT_MESSENGER=https://m.me/yourpage

# ─── Public (inlined into the browser bundle, no secrets here) ─────────────
# Public base URL of this site. Card URLs are built as <SITE_URL>/c/<slug>,
# so set this to your final domain BEFORE writing any NFC tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
